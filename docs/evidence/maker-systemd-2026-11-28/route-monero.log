## Give the Maker its Monero role (docs/maker-systemd-install.md, "Monero")
$ systemd-creds encrypt --name=monerod.login /payload/stack/maker/monerod.login /etc/lez/maker/credentials/monerod.login.cred
Credential secret file '/var/lib/systemd/credential.secret' is not located on encrypted media, using anyway.
[exit 0]
$ systemd-creds encrypt --name=monero-wallet-rpc.login /payload/stack/maker/monero-wallet-rpc.login /etc/lez/maker/credentials/monero-wallet-rpc.login.cred
Credential secret file '/var/lib/systemd/credential.secret' is not located on encrypted media, using anyway.
[exit 0]
$ install -D -m 0644 /etc/lez/maker/monero.conf.example /etc/systemd/system/lez-maker-node.service.d/monero.conf
[exit 0]
$ cat /etc/systemd/system/lez-maker-node.service.d/monero.conf
# /etc/systemd/system/lez-maker-node.service.d/monero.conf: a Maker with a Monero role
# (docs/maker-systemd-install.md, "Monero"). It loads monerod's and the role wallet-rpc's
# logins (user:password) as encrypted credentials and names their directory to the role
# launcher, which then writes the Monero role; without this drop-in the Maker has none.
[Service]
LoadCredentialEncrypted=monerod.login:/etc/lez/maker/credentials/monerod.login.cred
LoadCredentialEncrypted=monero-wallet-rpc.login:/etc/lez/maker/credentials/monero-wallet-rpc.login.cred
Environment=LEZ_MONERO_LOGIN_DIR=/run/credentials/lez-maker-node.service
# The windows after the take, in seconds (packaging defaults; the devnet's fast profile
# is 320, 720 and 1000, from deploy/scripts/gen-config.sh); the Taker must use
# the same three. /etc/lez/maker/env overrides them.
Environment=LEZ_XMR_MAKER_FUNDING_CUTOFF_SECONDS=260
Environment=LEZ_XMR_REFUND_SECONDS=700
Environment=LEZ_XMR_PUNISH_SECONDS=1000
[exit 0]
$ systemctl daemon-reload
[exit 0]
$ systemctl restart lez-maker-node
[exit 0]
