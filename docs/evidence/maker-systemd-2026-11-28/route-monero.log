## Why a drop-in: a credential the unit names must exist, and an empty default fails the start
$ systemd-run --quiet --wait --pipe -p LoadCredential=probe.login:/nonexistent/probe.login true
[exit 243]
$ systemd-run --quiet --wait --pipe -p SetCredential=probe.login: -p LoadCredential=probe.login:/nonexistent/probe.login true
[exit 1]

## No copy of either LEZ signer key on disk: only the encrypted credentials
$ find / -xdev -name lez-signer.key* -not -path /payload/*
/etc/lez/maker/credentials/lez-signer.key.cred
/etc/lez/taker/credentials/lez-signer.key.cred
[exit 0]

