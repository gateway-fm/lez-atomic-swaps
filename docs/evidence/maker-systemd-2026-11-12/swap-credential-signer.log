## Prerequisites: jq and socat (the launcher's), from Ubuntu's archive
$ sh -c dpkg -i /payload/debs/*.deb >/dev/null && dpkg-query -W jq socat
jq	1.7.1-3ubuntu0.24.04.2
socat	1.8.0.0-4ubuntu0.1
[exit 0]

## Install both roles (docs/maker-systemd-install.md)
$ useradd --system --no-create-home --shell /usr/sbin/nologin lez-swap
[exit 0]
$ env SOURCE_BIN_DIR=/payload/bin /payload/scripts/install-maker-node-service.sh
installed canonical Maker Node artifacts below /
[exit 0]
$ env SOURCE_BIN_DIR=/payload/bin /payload/scripts/install-taker-node-service.sh
installed canonical Taker Node artifacts below /
[exit 0]

## The chains on loopback: QEMU forwards 10.0.2.100 to the devnet, socat to 127.0.0.1
$ systemd-run --quiet --unit=lez-chain-18443 -p Restart=always socat TCP-LISTEN:18443,bind=127.0.0.1,fork,reuseaddr TCP:10.0.2.100:18443
[exit 0]
$ systemd-run --quiet --unit=lez-chain-3040 -p Restart=always socat TCP-LISTEN:3040,bind=127.0.0.1,fork,reuseaddr TCP:10.0.2.100:3040
[exit 0]
$ systemd-run --quiet --unit=lez-chain-8779 -p Restart=always socat TCP-LISTEN:8779,bind=127.0.0.1,fork,reuseaddr TCP:10.0.2.100:8779
[exit 0]
$ sh -c curl -sS --user "$(cat /payload/stack/btc-rpc-cookie)" -H "content-type: application/json" --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getblockcount\",\"params\":[]}" http://127.0.0.1:18443/
{"jsonrpc":"2.0","result":100054,"id":1}
[exit 0]
