## Prerequisites: jq and socat (the launcher's), from Ubuntu's archive
$ sh -c dpkg -i /payload/debs/*.deb >/dev/null && dpkg-query -W jq socat
jq	1.7.1-3ubuntu0.24.04.2
socat	1.8.0.0-4ubuntu0.1
[exit 0]

## Install both roles (docs/maker-systemd-install.md)
$ useradd --system --no-create-home --shell /usr/sbin/nologin lez-swap
[exit 0]
$ env SOURCE_BIN_DIR=/payload/bin /payload/scripts/install-maker-node-service.sh
installed canonical Maker Node artifacts below /
[exit 0]
$ env SOURCE_BIN_DIR=/payload/bin /payload/scripts/install-taker-node-service.sh
installed canonical Taker Node artifacts below /
[exit 0]

## The chains on loopback: QEMU forwards 10.0.2.100 to the devnet, socat to 127.0.0.1
$ systemd-run --quiet --unit=lez-chain-18443 -p Restart=always socat TCP-LISTEN:18443,bind=127.0.0.1,fork,reuseaddr TCP:10.0.2.100:18443
[exit 0]
$ systemd-run --quiet --unit=lez-chain-3040 -p Restart=always socat TCP-LISTEN:3040,bind=127.0.0.1,fork,reuseaddr TCP:10.0.2.100:3040
[exit 0]
$ systemd-run --quiet --unit=lez-chain-8779 -p Restart=always socat TCP-LISTEN:8779,bind=127.0.0.1,fork,reuseaddr TCP:10.0.2.100:8779
[exit 0]
$ sh -c curl -sS --user "$(cat /payload/stack/btc-rpc-cookie)" -H "content-type: application/json" --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getblockcount\",\"params\":[]}" http://127.0.0.1:18443/
{"jsonrpc":"2.0","result":98709,"id":1}
[exit 0]
$ curl -sS http://127.0.0.1:8779/ -H content-type: application/json --data {"jsonrpc":"2.0","id":1,"method":"getLastFinalizedBlockId","params":[]}
{"jsonrpc":"2.0","id":1,"result":547}[exit 0]

## Inputs: credentials, identities, cookie copies, market constants, env files
$ head -c 32 /dev/urandom | systemd-creds encrypt --name=delivery-signing.key - /etc/lez/maker/credentials/delivery-signing.key.cred
$ head -c 32 /dev/urandom | systemd-creds encrypt --name=maker-claim-recovery.key - /etc/lez/maker/credentials/maker-claim-recovery.key.cred
$ head -c 32 /dev/urandom | systemd-creds encrypt --name=maker-claim-preimage.key - /etc/lez/maker/credentials/maker-claim-preimage.key.cred
$ install -m 0644 /payload/stack/market-bootstrap.env /etc/lez/market-bootstrap.env
[exit 0]
$ install -d -m 0755 /etc/lez/maker/identity
[exit 0]
$ install -o lez-swap -g lez-swap -m 0400 /payload/stack/maker/identity.json /payload/stack/maker/lez-signer.key /etc/lez/maker/identity/
[exit 0]
$ install -o lez-swap -g lez-swap -m 0400 /payload/stack/btc-rpc-cookie /etc/lez/maker/btc-rpc-cookie
[exit 0]
$ cat /etc/lez/maker/env
# /etc/lez/maker/env: the role launcher's inputs (modules/lez-role-node/node-entrypoint.sh).
# The role's LEZ identity: identity.json and lez-signer.key (owned by lez-swap, mode 0400).
LEZ_IDENTITY_DIR=/etc/lez/maker/identity
# The market's public constants: M3_POC_LEZ_ESCROW_PROGRAM_ID, M3_POC_LEZ_GENESIS_BLOCK_HASH.
LEZ_MARKET_MANIFEST=/etc/lez/market-bootstrap.env
# A copy of Bitcoin Core's RPC cookie the service user can read.
LEZ_BTC_RPC_COOKIE_FILE=/etc/lez/maker/btc-rpc-cookie
LEZ_BTC_WALLET=lez-maker
LEZ_BTC_CLAIM_DESTINATION=wallet
LEZ_DELIVERY_DIR=/var/lib/lez/maker/delivery
LEZ_DELIVERY_SIGNING_KEY_FILE=/run/credentials/lez-maker-node.service/delivery-signing.key
# Bitcoin Core on 127.0.0.1:18443 and the LEZ sequencer and indexer below answer on loopback.
LEZ_CHAIN_FORWARDS=0
LEZ_SEQUENCER_URL=http://127.0.0.1:3040
LEZ_INDEXER_URL=http://127.0.0.1:8779
LEZ_SIDECAR_PORT_BASE=19000
LEZ_BTC_REFUND_CSV_BLOCKS=420
LEZ_BTC_SECOND_LOCK_REFUND_CSV_BLOCKS=240
LEZ_BTC_BLOCK_SECONDS_FASTEST=2
LEZ_BTC_BLOCK_SECONDS_SLOWEST=2
LEZ_BTC_MAKER_LOCK_CUTOFF_SECONDS=240
LEZ_BTC_EARLIER_REFUND_SECONDS=420
LEZ_BTC_LATER_REFUND_SECONDS=840
LEZ_BTC_REFUND_MARGIN_SECONDS=60
LEZ_LEZ_DISCOVERY_MAX_BLOCKS=300
LEZ_BTC_BLOCK_SECONDS=2
LEZ_BTC_ACTOR_TRACE=
LEZ_MAKER_ACTOR_REQUEUE_SECONDS=2
LEZ_MAKER_ACTOR_FAILURE_BACKOFF_SECONDS=10
LEZ_TAKER_OBSERVER_SWEEP_SECONDS=3
LEZ_NODE_FINALITY_STALL_SECONDS=60
LEZ_V02_CHANNEL_ID=b6adb2d238911395adde0b2f40b880ec03ffd1a3a8d97e7df8cacadf08873748
