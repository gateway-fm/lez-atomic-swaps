## The key the Node read: a systemd credential, root-owned
$ systemd-run --quiet --wait --pipe -p User=lez-swap -p LoadCredentialEncrypted=delivery-signing.key:/etc/lez/maker/credentials/delivery-signing.key.cred sh -c id; stat -c "%n %U:%G %a" "$CREDENTIALS_DIRECTORY" "$CREDENTIALS_DIRECTORY"/*
