flowchart TB
    classDef api fill:#eef4ff,stroke:#2459a9,color:#102a43,stroke-width:1.5px
    classDef app fill:#eaf8f0,stroke:#237a45,color:#123524,stroke-width:1.5px
    classDef store fill:#f5efff,stroke:#7048a8,color:#2d174f,stroke-width:1.5px
    classDef child fill:#fff3df,stroke:#b86600,color:#4a2a00,stroke-width:1.5px
    classDef unsafe fill:#fff0f0,stroke:#b42318,color:#5b1510,stroke-width:2px
    classDef external fill:#f5f5f5,stroke:#666,color:#222,stroke-dasharray:5 4

    subgraph Entrypoint["lez-maker-daemon process"]
        OwnerSocket["owner_rpc_server\nmode-0600 Unix socket"]
        ChatSocket["pair Chat RPC\nseparate optional Unix socket"]
        Lifecycle["daemon startup / readiness / shutdown\nJoinSet + systemd notify"]
        MakerRpc["MakerRpc application facade"]
        Health["route_health\nperiodic reconciliation"]
        Delivery["run_local_delivery\nsigned offers"]
        Price["logos_price_source\nprocess adapter"]
        Supervisor["actor_supervisor\nleases + bounded workers"]
    end

    subgraph PairModules["Pair-specific application modules in the same crate"]
        BtcChat["btc_chat"]
        ZecAccept["zec_taker_accept"]
        XmrChat["xmr_chat"]
        TakerService["taker_service / backend / facade"]
        Gateway["logos_chat_gateway"]
    end

    subgraph Stores["lez-swap-store modules"]
        Offers[("maker_offer + maker_application")]
        ActorState[("maker_actor_process")]
        Recovery[("BTC / ZEC recovery")]
        Effects[("public / bridge / XMR journals")]
        TakerRegistry[("taker_facade_registry")]
    end

    subgraph Children["Crash- or authority-isolated child processes"]
        BtcActor["btc-reference-actor"]
        ZecActor["zec-reference-actor"]
        XmrActor["xmr-maker-actor"]
        PriceWorker["lez-logos-price-worker"]
        CModule["pinned native price module\nunsafe C ABI"]
    end

    subgraph Chains["Adapters and external runtimes"]
        BtcAdapter["BTC SDK + Core adapter"]
        LezAdapter["LEZ bridge client / sidecar"]
        ZecAdapter["Zebra adapter"]
        XmrAdapter["Monero adapter / release authority"]
        Nodes["Bitcoin Core / LEZ / Zebra / monerod"]
    end

    OwnerSocket --> MakerRpc
    ChatSocket --> MakerRpc
    Lifecycle --> OwnerSocket
    Lifecycle --> ChatSocket
    Lifecycle --> Supervisor
    Lifecycle --> Health
    MakerRpc --> Delivery
    MakerRpc --> Price
    MakerRpc --> BtcChat
    MakerRpc --> ZecAccept
    MakerRpc --> XmrChat
    MakerRpc --> TakerService
    Gateway --> ChatSocket

    MakerRpc --> Offers
    MakerRpc --> Recovery
    TakerService --> TakerRegistry
    Supervisor --> ActorState
    Supervisor --> Effects

    Supervisor -->|"sealed fd 196 + empty env\nprogram/config hashes"| BtcActor
    Supervisor -->|"sealed fd 196 + empty env\nprogram/config hashes"| ZecActor
    Supervisor -->|"sealed fd 196 + empty env\nprogram/config hashes"| XmrActor
    Price -->|"bounded stdout + timeout\nempty env"| PriceWorker
    PriceWorker --> CModule

    BtcActor --> BtcAdapter
    ZecActor --> LezAdapter
    ZecActor --> ZecAdapter
    XmrActor --> LezAdapter
    XmrActor --> XmrAdapter
    BtcAdapter --> Nodes
    LezAdapter --> Nodes
    ZecAdapter --> Nodes
    XmrAdapter --> Nodes

    class OwnerSocket,ChatSocket api
    class Lifecycle,MakerRpc,Health,Delivery,Price,Supervisor,BtcChat,ZecAccept,XmrChat,TakerService,Gateway app
    class Offers,ActorState,Recovery,Effects,TakerRegistry store
    class BtcActor,ZecActor,XmrActor,PriceWorker child
    class CModule unsafe
    class BtcAdapter,LezAdapter,ZecAdapter,XmrAdapter,Nodes external

