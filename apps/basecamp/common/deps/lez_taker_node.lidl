; lez_taker_node contract — the package that carries the Taker Node (the Node,
; its CLI, actors, the LEZ v0.2 sidecar and the launcher under bin/,
; modules/lez-taker-node). The Taker desk asks it for the launcher and has
; lez_swap_node start the Node from it (lez_role_node.h). Supplied as a
; dependency_override (see the role metadata.json). Hand-maintained: keep it in
; sync with modules/lez-taker-node/src/lez_taker_node_impl.h.
module lez_taker_node {
  version "0.1.0"

  method launcher() -> tstr
  method payload() -> tstr
}
