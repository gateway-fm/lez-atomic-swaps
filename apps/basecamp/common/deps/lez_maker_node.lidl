; lez_maker_node contract — the package that carries the Maker Node (the Node,
; its CLI, actors, the LEZ v0.2 sidecar and the launcher under bin/,
; modules/lez-maker-node). The Maker desk asks it for the launcher and has
; lez_swap_node start the Node from it (lez_role_node.h). Supplied as a
; dependency_override (see the role metadata.json). Hand-maintained: keep it in
; sync with modules/lez-maker-node/src/lez_maker_node_impl.h.
module lez_maker_node {
  version "0.3.0"

  method launcher() -> tstr
  method payload() -> tstr
}
