/// Parse a hex string into ProgramId [u32; 8] (little-endian byte order).
pub fn parse_program_id_hex(s: &str) -> Result<ProgramId, String> {
    let s = s.trim_start_matches("0x");
    if s.len() != 64 {
        return Err(format!("program_id hex must be 64 chars, got {}", s.len()));
    }
    let bytes = hex::decode(s).map_err(|e| format!("invalid hex: {}", e))?;
    let mut pid = [0u32; 8];
    for (i, chunk) in bytes.chunks(4).enumerate() {
        pid[i] = u32::from_le_bytes(chunk.try_into().unwrap());
    }
    Ok(pid)
}

/// Compute PDA for the `metadata` account.
pub fn compute_metadata_pda(program_id: &ProgramId, swap_id: &[u8; 32]) -> AccountId {
    spel_framework_core::pda::compute_pda(program_id, &[
        swap_id,
    ])
}

/// Compute PDA for the `custody` account.
pub fn compute_custody_pda(program_id: &ProgramId, swap_id: &[u8; 32]) -> AccountId {
    let seed_const_0 = spel_framework_core::pda::seed_from_str("custody");
    spel_framework_core::pda::compute_pda(program_id, &[
        &seed_const_0,
        swap_id,
    ])
}

