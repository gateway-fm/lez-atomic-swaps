# /etc/lez/maker/env: the role launcher's inputs (modules/lez-role-node/node-entrypoint.sh).
# The role's LEZ identity: identity.json and lez-signer.key (owned by lez-swap, mode 0400).
LEZ_IDENTITY_DIR=/etc/lez/maker/identity
# The market's public constants: M3_POC_LEZ_ESCROW_PROGRAM_ID, M3_POC_LEZ_GENESIS_BLOCK_HASH.
LEZ_MARKET_MANIFEST=/etc/lez/market-bootstrap.env
# A copy of Bitcoin Core's RPC cookie the service user can read.
LEZ_BTC_RPC_COOKIE_FILE=/etc/lez/maker/btc-rpc-cookie
LEZ_BTC_WALLET=REPLACE_WITH_THE_MAKERS_CORE_WALLET
LEZ_BTC_CLAIM_DESTINATION=wallet
LEZ_DELIVERY_DIR=/var/lib/lez/maker/delivery
LEZ_DELIVERY_SIGNING_KEY_FILE=/run/credentials/lez-maker-node.service/delivery-signing.key
# Bitcoin Core on 127.0.0.1:18443 and the LEZ sequencer and indexer below answer on loopback.
LEZ_CHAIN_FORWARDS=0
LEZ_SEQUENCER_URL=http://127.0.0.1:3040
LEZ_INDEXER_URL=http://127.0.0.1:8779
LEZ_V02_CHANNEL_ID=REPLACE_WITH_THE_LEZ_CHANNEL_ID
LEZ_SIDECAR_PORT_BASE=19000
# The launcher's Zcash state, inside the unit's StateDirectory.
LEZ_ZEC_STATE_DIR=/var/lib/lez/maker/zec
