[Unit]
Description=LEZ atomic-swap maker daemon
Documentation=https://github.com/gateway-fm/lez-atomic-swaps
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=lez-swap
Group=lez-swap
UMask=0077
RuntimeDirectory=lez-atomic-swaps
RuntimeDirectoryMode=0700
StateDirectory=lez-atomic-swaps
StateDirectoryMode=0700
WorkingDirectory=/var/lib/lez-atomic-swaps
LoadCredentialEncrypted=delivery-signing.key:/etc/lez-atomic-swaps/credentials/delivery-signing.key.cred
LoadCredentialEncrypted=maker-claim-recovery.key:/etc/lez-atomic-swaps/credentials/maker-claim-recovery.key.cred
LoadCredentialEncrypted=maker-claim-preimage.key:/etc/lez-atomic-swaps/credentials/maker-claim-preimage.key.cred
ExecStart=/usr/bin/lez-maker-daemon \
  --socket /run/lez-atomic-swaps/maker.sock \
  --database /var/lib/lez-atomic-swaps/maker.sqlite3 \
  --ready-file /run/lez-atomic-swaps/ready \
  --delivery-directory /var/lib/lez-atomic-swaps/delivery \
  --delivery-signing-key-file %d/delivery-signing.key \
  --chat-socket /run/lez-atomic-swaps/chat.sock \
  --maker-claim-key-id systemd-v1 \
  --maker-claim-key-file %d/maker-claim-recovery.key \
  --maker-claim-preimage-file %d/maker-claim-preimage.key
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=control-group

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service memfd_create
SystemCallErrorNumber=EPERM
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
