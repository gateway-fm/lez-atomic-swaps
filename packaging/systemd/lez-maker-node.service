[Unit]
Description=LEZ atomic-swap Maker Node
Documentation=https://github.com/gateway-fm/lez-atomic-swaps
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=lez-swap
Group=lez-swap
UMask=0077
RuntimeDirectory=lez/maker
RuntimeDirectoryMode=0700
StateDirectory=lez/maker
StateDirectoryMode=0700
WorkingDirectory=/var/lib/lez/maker
LoadCredentialEncrypted=delivery-signing.key:/etc/lez/maker/credentials/delivery-signing.key.cred
LoadCredentialEncrypted=maker-claim-recovery.key:/etc/lez/maker/credentials/maker-claim-recovery.key.cred
LoadCredentialEncrypted=maker-claim-preimage.key:/etc/lez/maker/credentials/maker-claim-preimage.key.cred
LoadCredentialEncrypted=lez-signer.key:/etc/lez/maker/credentials/lez-signer.key.cred
# The role launcher (modules/lez-role-node/node-entrypoint.sh) renders the Node's
# configuration from this file's inputs and execs the Node, which stays the main process.
EnvironmentFile=/etc/lez/maker/env
ExecStart=/usr/bin/lez-role-node-launcher maker
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=control-group

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
# No RestrictSUIDSGID=: it makes openat2() fail with ENOSYS, and the Node opens every
# state and key file with openat2(RESOLVE_NO_SYMLINKS), so it cannot start under it.
# It can write only its mode-0700 state and runtime directories and a private /tmp, so a
# set-ID file it made would be out of every other user's reach.
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service memfd_create
SystemCallErrorNumber=EPERM
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
