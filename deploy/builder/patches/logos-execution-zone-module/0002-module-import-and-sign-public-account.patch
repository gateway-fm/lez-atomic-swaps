+std::string LEZCoreModule::sign_public_message_hash(const std::string& account_id_hex, const std::string& message_hash_hex) {
+    nlohmann::json obj = nlohmann::json::object();
+    FfiBytes32 id{}, hash{};
+    if (!hexToBytes32(account_id_hex, &id) || !hexToBytes32(message_hash_hex, &hash)) {
+        fprintf(stderr, "sign_public_message_hash: invalid hex\n");
+        obj["error"] = "sign_public_message_hash: account_id_hex and message_hash_hex must be 64 hex characters";
+        return obj.dump();
+    }
+    uint8_t signature[64]{};
+    FfiBytes32 publicKey{};
+    const WalletFfiError error = wallet_ffi_sign_public_message_hash(walletHandle, &id, &hash, &signature, &publicKey);
+    if (error != SUCCESS) {
+        fprintf(stderr, "sign_public_message_hash: wallet FFI error %d\n", error);
+        obj["error"] = "sign_public_message_hash: wallet FFI error " + std::to_string(error);
+        return obj.dump();
+    }
+    obj["signature"] = bytesToHex(signature, sizeof(signature));
+    obj["public_key"] = bytes32ToHex(publicKey);
+    return obj.dump();
+}
+
+int64_t LEZCoreModule::ensure_wallet(const std::string& config_path, const std::string& storage_path, const std::string& statistics_path, const std::string& password) {
+    if (walletHandle) {
+        return SUCCESS;
+    }
+    struct stat existing{};
+    if (stat(storage_path.c_str(), &existing) == 0) {
+        return open(config_path, storage_path, statistics_path);
+    }
+    return create_new(config_path, storage_path, statistics_path, password).empty() ? INTERNAL_ERROR : SUCCESS;
+}
