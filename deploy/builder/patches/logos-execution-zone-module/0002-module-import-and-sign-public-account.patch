+// One signing request per connection: read one line, answer one line, close.
+void answerSignerConnection(LEZCoreModule* module, int connection, const std::string& account) {
+    timeval timeout{10, 0};
+    setsockopt(connection, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+    setsockopt(connection, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+    std::string line;
+    char byte = 0;
+    while (line.size() < 1024 && read(connection, &byte, 1) == 1 && byte != '\n') {
+        line.push_back(byte);
+    }
+    nlohmann::json answer = nlohmann::json::object();
+    const nlohmann::json request = nlohmann::json::parse(line, nullptr, false);
+    if (!request.is_object() || !request.contains("account_id") || !request.contains("message_hash")
+        || !request["account_id"].is_string() || !request["message_hash"].is_string()) {
+        answer["error"] = "the request must be {\"account_id\", \"message_hash\"}";
+    } else {
+        std::string requested = request["account_id"].get<std::string>();
+        std::transform(requested.begin(), requested.end(), requested.begin(), ::tolower);
+        if (requested != account) {
+            answer["error"] = "this signer holds another account";
+        } else {
+            answer = nlohmann::json::parse(module->sign_public_message_hash(account, request["message_hash"].get<std::string>()), nullptr, false);
+            if (!answer.is_object()) {
+                answer = nlohmann::json::object({{"error", "the wallet did not sign"}});
+            }
+        }
+    }
+    const std::string reply = answer.dump() + "\n";
+    (void)write(connection, reply.data(), reply.size());
+    close(connection);
+}
