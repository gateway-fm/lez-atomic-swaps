@@ -329,6 +332,16 @@ impl RocksDBIO {
     }
 
     fn open_inner(path: &Path, db_opts: &Options) -> DbResult<Self> {
+        // `cf_lee_state` takes a whole state with every block and fills a
+        // memtable in seconds, while `cf_block` and `cf_meta` take a few small
+        // writes and almost never fill one; their unflushed entries keep alive
+        // every write-ahead log file written since. RocksDB's own bound (0: four
+        // times all memtable budgets, 12.5 GiB with 16 buffers per family) lets
+        // that grow to gigabytes; past this one, the families holding the
+        // oldest log are flushed and it is dropped.
+        let mut db_opts = db_opts.clone();
+        db_opts.set_max_total_wal_size(MAX_TOTAL_WAL_SIZE);
+
         let mut cf_opts = Options::default();
         cf_opts.set_max_write_buffer_number(16);
 
