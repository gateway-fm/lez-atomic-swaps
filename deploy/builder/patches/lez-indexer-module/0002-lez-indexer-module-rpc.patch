+int64_t LezIndexerModuleImpl::serve_rpc(int64_t port) {
+    if (!indexer_service_ffi) {
+        warn("serve_rpc", "indexer not started");
+        return 1;  // OperationStatus NullPointer
+    }
+    if (port <= 0 || port > 65535) {
+        warn("serve_rpc", "port out of range");
+        return 3;  // OperationStatus ClientError
+    }
+    const auto status = ::indexer_rpc_serve(handle(indexer_service_ffi), static_cast<uint16_t>(port));
+    if (is_error(&status)) {
+        warn("serve_rpc", "indexer FFI could not serve the JSON-RPC");
+    }
+    return static_cast<int64_t>(status);
+}
