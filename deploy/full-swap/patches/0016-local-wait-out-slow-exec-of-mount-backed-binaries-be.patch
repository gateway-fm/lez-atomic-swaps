From 3018c9691916c70c8cfbb1787aa6ea504b03271e Mon Sep 17 00:00:00 2001
From: mandrigin <igor@gateway.fm>
Date: Tue, 18 Aug 2026 02:05:11 +0200
Subject: [PATCH 16/26] local: wait out slow exec of mount-backed binaries
 before the drift check

---
 scripts/run-m3-actor-direction.sh | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/scripts/run-m3-actor-direction.sh b/scripts/run-m3-actor-direction.sh
index a8d9e85..96725d0 100755
--- a/scripts/run-m3-actor-direction.sh
+++ b/scripts/run-m3-actor-direction.sh
@@ -771,7 +771,16 @@ register_process() {
   local pid="$3"
   local start executable
   start="$(awk '{print $22}' "/proc/${pid}/stat")"
-  executable="$(readlink -f "/proc/${pid}/exe")"
+  executable=""
+  # local: a very large binary on a virtiofs bind mount takes visible time to
+  # exec; poll until /proc/<pid>/exe reflects the target (or the child dies)
+  for _ in {1..200}; do
+    executable="$(readlink -f "/proc/${pid}/exe" 2>/dev/null || true)"
+    [[ -n "$executable" && "$executable" != "/usr/bin/bash" ]] && break
+    kill -0 "$pid" 2>/dev/null || break
+    sleep 0.1
+  done
+  [[ -n "$executable" ]] || executable="$(readlink -f "/proc/${pid}/exe")"
   if [[ "$executable" != "$M3_POC_LEZ_SIDECAR_BIN" ]]; then
     local cmdline stat_ppid
     cmdline="$(tr "\0" " " < "/proc/${pid}/cmdline" 2>/dev/null | head -c 200)"
