From aea991fbd0b1a47667c96aaebb552b9098a0a264 Mon Sep 17 00:00:00 2001
From: mandrigin <igor@gateway.fm>
Date: Mon, 17 Aug 2026 22:40:45 +0200
Subject: [PATCH 04/26] local(arm64): stub RISC0_HOME satisfies risc0-build
 toolchain probe for docker guest builds

---
 scripts/verify-lez-v02-provisional.sh | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/scripts/verify-lez-v02-provisional.sh b/scripts/verify-lez-v02-provisional.sh
index 35d0629..44a26a8 100755
--- a/scripts/verify-lez-v02-provisional.sh
+++ b/scripts/verify-lez-v02-provisional.sh
@@ -86,6 +86,9 @@ if [[ "${LEZ_NATIVE_TOOLS:-0}" == "1" ]]; then
   fi
   export PATH="${LEZ_V02_TOOL_DIR}/bin:${PATH}"
   export RISC0_SERVER_PATH="$LEZ_V02_NATIVE_R0VM"
+  # risc0-build probes rzup for a default rust version even when the guest is
+  # built inside the pinned docker image; a stub home satisfies the probe.
+  export RISC0_HOME="${LEZ_V02_NATIVE_RISC0_HOME:-/tmp/lez-risc0-home}"
   if [[ "$(cargo risczero --version)" != "cargo-risczero ${risc0_version}" ]]; then
     echo "expected cargo-risczero ${risc0_version}" >&2
     exit 1
