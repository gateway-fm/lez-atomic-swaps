From 062cc7c173fcd12147271bab032fb4aabaa55485 Mon Sep 17 00:00:00 2001
From: mandrigin <igor@gateway.fm>
Date: Tue, 18 Aug 2026 01:09:59 +0200
Subject: [PATCH 11/26] local: compose create (no --no-start flag on this
 plugin version)

---
 scripts/run-bitcoin-core-e2e.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/scripts/run-bitcoin-core-e2e.sh b/scripts/run-bitcoin-core-e2e.sh
index b555ce9..89386b6 100755
--- a/scripts/run-bitcoin-core-e2e.sh
+++ b/scripts/run-bitcoin-core-e2e.sh
@@ -835,7 +835,7 @@ docker volume create \
 # Docker Desktop engines do not expose to --network host processes; compose
 # carries the mode:host port spec from compose.yml, which is. Same name,
 # network, volume, and config mount as the raw create it replaces.
-"${compose[@]}" create --no-start >/dev/null
+"${compose[@]}" create >/dev/null
 container_id="$(docker ps -aq --filter "name=${project}-bitcoin-core" | head -1)"
 if [[ -z "$container_id" ]]; then
   echo "Docker did not create the run-owned Bitcoin Core container" >&2
