From 60d112072d8f885e11e65d7850f0bc531be3ee94 Mon Sep 17 00:00:00 2001
From: mandrigin <igor@gateway.fm>
Date: Tue, 18 Aug 2026 00:52:34 +0200
Subject: [PATCH 09/16] local: drop the stale-keyring refusal for the per-run
 mktemp gpg home

---
 scripts/verify-bitcoin-core-release.sh | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/scripts/verify-bitcoin-core-release.sh b/scripts/verify-bitcoin-core-release.sh
index 1c4a73c..3e4c1c2 100755
--- a/scripts/verify-bitcoin-core-release.sh
+++ b/scripts/verify-bitcoin-core-release.sh
@@ -190,11 +190,6 @@ fi
 # keep the keyring in a per-run local homedir (verification unchanged)
 gnupg_home="$(mktemp -d /tmp/lez-gnupg-home.XXXXXX)"
 chmod 0700 "$gnupg_home"
-if [[ -e "$gnupg_home" ]]; then
-  echo "refusing to reuse Bitcoin Core verification keyring: ${gnupg_home}" >&2
-  exit 1
-fi
-mkdir -m 0700 "$gnupg_home"
 gpg --homedir "$gnupg_home" --batch --import "${guix_dir}"/builder-keys/*.gpg >/dev/null 2>&1
 
 gpg_status="${BITCOIN_CORE_CACHE_DIR}/release-signatures.status"
-- 
2.50.1 (Apple Git-155)

