 provision_actor_identities() {
+  if [[ "$attach_mode" == 1 ]]; then
+    # Persistent wallets: the swap acts for long-lived funded identities
+    # (selected by the caller), not throwaway per-run keys.
+    local maker_src="${LEZ_ATTACH_MAKER_IDENTITY_DIR:?attach mode requires LEZ_ATTACH_MAKER_IDENTITY_DIR}"
+    local taker_src="${LEZ_ATTACH_TAKER_IDENTITY_DIR:?attach mode requires LEZ_ATTACH_TAKER_IDENTITY_DIR}"
+    local role src
+    for role in maker taker; do
+      src="$maker_src"; [[ "$role" == taker ]] && src="$taker_src"
+      [[ -f "$src/identity.json" && -f "$src/lez-signer.key" ]] ||
+        fail "persistent ${role} identity is incomplete: ${src}"
+      mkdir -m 0700 -p "${identities_dir}/${role}"
+      install -m 0600 "$src/identity.json" "${identities_dir}/${role}/identity.json"
+      install -m 0600 "$src/lez-signer.key" "${identities_dir}/${role}/lez-signer.key"
+      install -m 0600 "$src/identity.json" "${evidence_dir}/${role}-lez-identity.json"
+    done
+  else
   "$identity_bin" --output-directory "${identities_dir}/maker" \
     >"${evidence_dir}/maker-lez-identity.json"
   "$identity_bin" --output-directory "${identities_dir}/taker" \
     >"${evidence_dir}/taker-lez-identity.json"
+  fi
   chmod 0600 "${evidence_dir}/maker-lez-identity.json" \
     "${evidence_dir}/taker-lez-identity.json"
   jq -e '.schema == "lez-v0.2-local-actor-identity" and .version == 2
@@ -2362,6 +2425,42 @@ start_actual_nodes() {
     : >"$log_file"
     chmod 0600 "$log_file"
   done
+  if [[ "$attach_mode" == 1 ]]; then
+    # Attach to the long-standing chains: no provisioning, no launcher waits.
+    # The labeled containers are discovered and asserted; the retained
+    # manifests are validated the same way a fresh run's would be.
+    printf 'attach mode: using standing Bitcoin chain run %s\n' \
+      "$bitcoin_run_id" >>"$bitcoin_log"
+    printf 'attach mode: using standing LEZ chain run %s\n' \
+      "$lez_run_id" >>"$lez_log"
+    reconcile_node_resource_inventories passed passed ||
+      fail "attached chain container inventory reconciliation failed"
+    jq -n --argjson owning_shell_pid "$owning_shell_pid" '
+      {schema_version:1,attach_mode:true,owning_shell_pid:$owning_shell_pid,
+       bitcoin_status:0,lez_status:0,
+       bitcoin_registered:true,lez_registered:true,
+       both_children_waited_and_reaped:true,
+       exact_process_groups_absent_after_wait:true,
+       inventory_reconciled:true}
+    ' >"${evidence_dir}/node-startup-status.json.partial"
+    chmod 0600 "${evidence_dir}/node-startup-status.json.partial"
+    mv "${evidence_dir}/node-startup-status.json.partial" \
+      "${evidence_dir}/node-startup-status.json"
+    [[ -f "$bitcoin_manifest" && ! -L "$bitcoin_manifest" &&
+       -f "$lez_manifest" && ! -L "$lez_manifest" ]] ||
+      fail "retained node manifests are unavailable"
+    [[ "$(stat -c '%a' "$bitcoin_manifest")" == 600 &&
+       "$(stat -c '%a' "$lez_manifest")" == 600 ]] ||
+      fail "retained node manifests are not owner-private"
+    [[ "$(manifest_value "$bitcoin_manifest" RUN_ID)" == "$bitcoin_run_id" &&
+       "$(manifest_value "$bitcoin_manifest" BITCOIN_CORE_E2E_MODE)" == service ]] ||
+      fail "Bitcoin standing manifest does not attest the attached run"
+    [[ "$(manifest_value "$lez_manifest" RUN_ID)" == "$lez_run_id" ]] ||
+      fail "LEZ standing manifest does not attest the attached run"
+    [[ "$(manifest_value "$lez_manifest" LEZ_V02_SLOT_DURATION_SECONDS)" == "$lez_slot_duration_seconds" ]] ||
+      fail "LEZ standing manifest does not attest the journey-selected slot duration"
+    return 0
+  fi
   bash_executable="$(readlink -f "$(command -v bash)")"
 
