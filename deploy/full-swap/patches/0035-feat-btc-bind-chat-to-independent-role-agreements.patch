+    assert_eq!(
+        derive_btc_pre_session_id_v1(&OFFER_COMMITMENT, &[], SwapDirection::TakerSellsForeign,),
+        Err(BtcRoleContributionV1Error::InvalidReservationBinding)
+    );
+    assert_ne!(
+        derive_btc_pre_session_id_v1(
+            &OFFER_COMMITMENT,
+            RESERVATION,
+            SwapDirection::TakerSellsForeign,
