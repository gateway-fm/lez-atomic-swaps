From ee2987e7c6e663c453288844e88fd6e4b04c6d09 Mon Sep 17 00:00:00 2001
From: mandrigin <igor@gateway.fm>
Date: Tue, 18 Aug 2026 00:44:12 +0200
Subject: [PATCH 08/16] local: gpg keyring in a per-run /tmp homedir (virtiofs
 cannot host gpg-agent locks)

---
 scripts/verify-bitcoin-core-release.sh | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/scripts/verify-bitcoin-core-release.sh b/scripts/verify-bitcoin-core-release.sh
index 35d7ca9..1c4a73c 100755
--- a/scripts/verify-bitcoin-core-release.sh
+++ b/scripts/verify-bitcoin-core-release.sh
@@ -186,7 +186,10 @@ if [[ "$(git -C "$guix_dir" rev-parse HEAD)" != "$BITCOIN_CORE_GUIX_SIGS_COMMIT"
   exit 1
 fi
 
-gnupg_home="${BITCOIN_CORE_CACHE_DIR}/gnupg"
+# local: gpg cannot run its agent/locks on the virtiofs fakeowner mount;
+# keep the keyring in a per-run local homedir (verification unchanged)
+gnupg_home="$(mktemp -d /tmp/lez-gnupg-home.XXXXXX)"
+chmod 0700 "$gnupg_home"
 if [[ -e "$gnupg_home" ]]; then
   echo "refusing to reuse Bitcoin Core verification keyring: ${gnupg_home}" >&2
   exit 1
-- 
