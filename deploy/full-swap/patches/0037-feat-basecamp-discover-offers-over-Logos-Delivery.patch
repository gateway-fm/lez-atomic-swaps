+    /// Lists only live, signed, locally uncontended offers.
+    pub fn list_offer_announcements(
+        &self,
+        request: LogosOfferListRequestV1,
+    ) -> Result<LogosOfferListV1, LogosChatGatewayError> {
+        validate_schema(request.schema_version)?;
