+            .locally_unavailable_offers
+            .lock()
+            .map_err(|_| LogosChatGatewayError::DependencyUnavailable)?;
+        unavailable.retain(|key| live_keys.contains(key));
+        Ok(LogosOfferListV1 {
+            schema_version: GATEWAY_SCHEMA_VERSION_V1,
+            offers,
+            unavailable_offers,
+            locally_contended_offers,
+            omitted_offers,
+        })
+    }
