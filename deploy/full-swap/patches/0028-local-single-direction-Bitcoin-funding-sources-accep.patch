From ffec2ca46b21663f30c03c4fede5d47b0075b10f Mon Sep 17 00:00:00 2001
From: local demo runner <runner@local>
Date: Wed, 19 Aug 2026 20:09:47 +0200
Subject: [PATCH 28/34] local: single-direction Bitcoin funding sources accept
 either route

The one-outpoint allocation may now carry taker_sells_lez as well as
taker_sells_foreign; the assignment rules themselves are unchanged.
---
 scripts/jq/m3-bitcoin-anchor-assignment.jq | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/scripts/jq/m3-bitcoin-anchor-assignment.jq b/scripts/jq/m3-bitcoin-anchor-assignment.jq
index 99ac6e7..d628a53 100644
--- a/scripts/jq/m3-bitcoin-anchor-assignment.jq
+++ b/scripts/jq/m3-bitcoin-anchor-assignment.jq
@@ -15,7 +15,8 @@ def valid_sources:
   and (
     (.allocation == "one_mature_coinbase_outpoint"
       and (.sources | length) == 1
-      and [.sources[].direction] == ["taker_sells_foreign"])
+      and ([.sources[].direction] == ["taker_sells_foreign"]
+           or [.sources[].direction] == ["taker_sells_lez"]))
     or
     (.allocation == "two_distinct_mature_coinbase_outpoints"
       and (.sources | length) == 2
