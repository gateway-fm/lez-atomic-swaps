From 88358c65443b71240245cc212771a2d39795556a Mon Sep 17 00:00:00 2001
From: local demo runner <runner@local>
Date: Wed, 19 Aug 2026 21:02:03 +0200
Subject: [PATCH 29/34] local: M5 terminal replay accepts both bounded
 application routes

---
 scripts/run-m3-actor-local-poc.sh | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/scripts/run-m3-actor-local-poc.sh b/scripts/run-m3-actor-local-poc.sh
index 6b297da..b7de189 100755
--- a/scripts/run-m3-actor-local-poc.sh
+++ b/scripts/run-m3-actor-local-poc.sh
@@ -3425,8 +3425,8 @@ terminal_replay_actor_config() {
       fail "M7 terminal replay agreement or receipt escaped shared authority"
     handoff_config="$(overlap_actor_config "$direction" "$role")"
   else
-    [[ "$direction" == taker_sells_foreign ]] ||
-      fail "M5 terminal replay supports only the accepted forward application"
+    [[ "$direction" == taker_sells_foreign || "$direction" == taker_sells_lez ]] ||
+      fail "M5 terminal replay supports only the accepted application routes"
   fi
   [[ "$role" =~ ^(maker|taker)$ &&
      "$swap_id" =~ ^[0-9a-f]{64}$ && -d "$owner_root" && ! -L "$owner_root" &&
