# testnet.env — environment for compose.testnet.yaml (docs/testnet-run.md).
#
#   docker compose -p lez-testnet --env-file testnet.env \
#     -f compose.yaml -f compose.testnet.yaml up -d maker-node taker-node basecamp-ui

LEZ_VOLUME_PREFIX=lez-testnet
LEZ_IMAGE_TAG=testnet
LEZ_V02_CHANNEL_ID=0101010101010101010101010101010101010101010101010101010101010101

# Recovery timing. Two public clocks set it:
# - Bitcoin testnet4 blocks arrive about every 20 minutes, and its median time
#   runs roughly 20 minutes ahead of the wall clock (blocks are stamped up to
#   two hours ahead); a Maker's Bitcoin lock counts only if its block's median
#   time is before the cutoff.
# - The official LEZ testnet makes about one block a minute and finalizes
#   about 50 blocks behind its tip, so a LEZ lock or claim is observable as
#   final roughly 50 minutes after it lands.
# A swap needs a confirmed Bitcoin lock, a finalized LEZ lock and a finalized
# claim before the earlier refund, so the cutoff is three hours and the
# refunds six and nine; the 144-block CSV (about 48 hours) exceeds both.
LEZ_BTC_MAKER_LOCK_CUTOFF_SECONDS=10800
LEZ_BTC_EARLIER_REFUND_SECONDS=21600
LEZ_BTC_LATER_REFUND_SECONDS=32400
LEZ_BTC_REFUND_MARGIN_SECONDS=600
LEZ_BTC_REFUND_CSV_BLOCKS=144
LEZ_LEZ_DISCOVERY_MAX_BLOCKS=2048

# Lock fee. The Node prices a Bitcoin lock itself (estimate, else 20 sat/vB,
# never above 25) and refuses one that costs more than this share of its value;
# the default is 5. The guide's 10,000 sat trades are smaller than any sensible
# fee allows -- about 3,100 sat at the fallback rate -- so this profile, and only
# this one, accepts up to 40 percent.
LEZ_BTC_LOCK_FEE_MAX_PERCENT=40

# compose.yaml interpolates these for the local chain services, which this
# stack never starts.
BTC_RPC_USER=unused
BTC_RPC_PASSWORD=unused
LEZ_MARKET_ROOT=/nonexistent
