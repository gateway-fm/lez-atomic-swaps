# testnet.env — environment for compose.testnet.yaml (docs/testnet-run.md).
#
#   docker compose -p lez-testnet --env-file testnet.env \
#     -f compose.yaml -f compose.testnet.yaml up -d maker-node taker-node

LEZ_VOLUME_PREFIX=lez-testnet
LEZ_IMAGE_TAG=testnet
LEZ_V02_CHANNEL_ID=0101010101010101010101010101010101010101010101010101010101010101

# Recovery timing. Two public clocks set it:
# - Bitcoin testnet4 blocks arrive about every 20 minutes, and its median time
#   runs roughly 20 minutes ahead of the wall clock (blocks are stamped up to
#   two hours ahead); a Maker's Bitcoin lock counts only if its block's median
#   time is before the cutoff.
# - The official LEZ testnet makes about one block a minute and finalizes
#   about 50 blocks behind its tip, so a LEZ lock or claim is observable as
#   final roughly 50 minutes after it lands.
# A swap needs a confirmed Bitcoin lock, a finalized LEZ lock and a finalized
# claim before the earlier refund, so the cutoff is three hours and the earlier
# refund six.
#
# The Bitcoin refund delays are blocks, and only their order against the LEZ
# refund times protects either side (a Bitcoin claim has no deadline on chain),
# so they are sized for the pace the chain may keep: Bitcoin's target of 600 s a
# block, and the 1,200 s testnet4 held for days. When Bitcoin is the second lock
# (the Maker's) 37 blocks cannot mature inside the six-hour claim window at the
# fast pace, and at the slow pace, locked as late as the cutoff, they mature in
# 15.5 hours: the later refund is therefore at 16. When Bitcoin is the first
# lock (the Taker's) 96 blocks cannot mature before those 16 hours. A Node
# refuses a profile that breaks this. The first public runs used 144 blocks
# against a nine-hour LEZ refund, which left a Taker selling LEZ able to refund
# it and still claim the Maker's Bitcoin.
LEZ_BTC_MAKER_LOCK_CUTOFF_SECONDS=10800
LEZ_BTC_EARLIER_REFUND_SECONDS=21600
LEZ_BTC_LATER_REFUND_SECONDS=57600
LEZ_BTC_REFUND_MARGIN_SECONDS=600
LEZ_BTC_REFUND_CSV_BLOCKS=96
LEZ_BTC_SECOND_LOCK_REFUND_CSV_BLOCKS=37
LEZ_BTC_BLOCK_SECONDS_FASTEST=600
LEZ_BTC_BLOCK_SECONDS_SLOWEST=1200
# A Taker's Bitcoin refund waits until this whole window of LEZ blocks is
# finalized, because only then is "the Maker never locked" proven. It starts at
# the finalized height of the take, about 50 blocks behind the tip, and must
# reach the cutoff 180 blocks later; 480 is twice that, eight hours, well
# inside the 16. The first public runs used 2,048, which is 34 hours at a
# block a minute and held a matured refund back for ten.
LEZ_LEZ_DISCOVERY_MAX_BLOCKS=480

# Lock fee. The Node prices a Bitcoin lock itself (estimate, else 20 sat/vB,
# never above 25) and refuses one that costs more than this share of its value;
# the default is 5. The guide's 10,000 sat trades are smaller than any sensible
# fee allows -- about 3,100 sat at the fallback rate -- so this profile, and only
# this one, accepts up to 40 percent.
LEZ_BTC_LOCK_FEE_MAX_PERCENT=40

# compose.yaml interpolates these for the local chain services, which this
# stack never starts.
BTC_RPC_USER=unused
BTC_RPC_PASSWORD=unused
LEZ_MARKET_ROOT=/nonexistent
