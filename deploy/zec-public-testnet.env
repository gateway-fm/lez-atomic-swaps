# zec-public-testnet.env — the public Zcash Testnet acceptance lane
# (scripts/public-zec-testnet.sh, docs/zcash-testnet-setup.md).
#
# This is the lane's runtime profile, not a chain: nothing here mines, nothing
# funds itself. Zcash Testnet is reached through a self-hosted Testnet Zebra
# (loopback JSON-RPC, cookie auth) or the one public provider the actor
# accepts (Tatum's Zebrad gateway, crates/zec-reference-actor/src/config.rs);
# LEZ is the official LEZ v0.2 testnet (docs/testnet-run.md). Every Zcash
# block is a real ~25 s Testnet block: confirmations are waited for, never
# generated, and funds come from an owner-funded transparent key only.
#
# Secrets are named by path and never stored here or in the evidence bundle:
#   LEZ_ZEC_PROVIDER_API_KEY_FILE   owner-only file holding the Tatum Testnet key
#   LEZ_ZEC_SELF_HOSTED_COOKIE_FILE the self-hosted Zebra's .cookie file

LEZ_ZEC_LANE_PROFILE=public-zec-testnet-v1

# The agreement profile the corridors are signed under (zec-swap-sdk
# profile.rs) and what it pins. The preflight refuses a Testnet whose next
# block is on another consensus branch: a transaction signed for the wrong
# branch is invalid, so there is nothing to try. deploy/tests keeps these equal
# to profile.rs.
LEZ_ZEC_SWAP_PROFILE=public-testnet-v1
LEZ_ZEC_SWAP_PROFILE_BRANCH=5437f330
LEZ_ZEC_SWAP_PROFILE_CONFIRMATIONS=10
LEZ_ZEC_SWAP_PROFILE_REFUND_BLOCKS=192

# Zcash Testnet's identity: `getblockchaininfo.chain` and the genesis hash
# (`getblockhash 0`), checked on every route before anything else.
LEZ_ZEC_TESTNET_CHAIN=test
LEZ_ZEC_TESTNET_GENESIS=05a60a92d99d85997cce3b87616c089f6124d7342af37106edc76126334a2c38
# A route whose tip is more than this many blocks behind its own estimate is
# not synchronized. Zebra estimates the height from the clock, so a synced
# node reads a few blocks behind (4 measured on Tatum, 2026-11-11).
LEZ_ZEC_MAX_TIP_LAG_BLOCKS=10

# Routes. The self-hosted one must be loopback (the actor accepts nothing
# else); the provider one is the exact origin the actor pins.
LEZ_ZEC_SELF_HOSTED_URL=http://127.0.0.1:18232/
LEZ_ZEC_PROVIDER_URL=https://zcash-testnet-zebrad.gateway.tatum.io
# Seconds between two requests on a route. Tatum without a key admits five
# requests a minute (HTTP 429, retry-after 60) and refuses batches (402,
# measured 2026-11-11), hence 13; a keyed or self-hosted route can go faster.
LEZ_ZEC_SELF_HOSTED_MIN_INTERVAL_SECONDS=0
LEZ_ZEC_PROVIDER_MIN_INTERVAL_SECONDS=13

# Waiting. The harness waits for organic blocks instead of mining: at most
# this long per block it needs (Testnet averaged 22.7 s a block from NU7 to
# 2026-11-11, with stretches far slower and min-difficulty bursts far faster).
LEZ_ZEC_BLOCK_WAIT_SECONDS=900
# node-e2e.py's ZEC waits are sized for a devnet that finalizes in seconds;
# the LEZ testnet finalizes ~50 blocks (~50 min) behind its tip, so every
# wait is multiplied by this.
LEZ_ZEC_TIMEOUT_SCALE=12

# The LEZ side: the official testnet sequencer and channel.
LEZ_LEZ_SEQUENCER_URL=https://testnet.lez.logos.co
LEZ_V02_CHANNEL_ID=0101010101010101010101010101010101010101010101010101010101010101
